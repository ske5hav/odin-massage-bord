<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mini Message Board (ODIN)</title>

  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-black text-black">

  <div class="max-w-3xl mx-auto px-4 py-10">

    <h1 class="text-3xl font-bold text-center mb-2 text-green-500">
      Mini Message Board (ODIN)
    </h1>

    <p class="text-center text-gray-600 mb-8">
      Share your thoughts with ODIN
    </p>

    <!-- Message Form -->
    <form action="/create" method="post"
      class="bg-gray-600 border-gray-300 p-6 rounded-lg mb-8">

      <label class="block mb-2 font-semibold">
        Title
      </label>

      <input
        type="text"
        name="title"
        placeholder="Enter message title"
        required
        class=" text-green-500 bg-gray-700 w-full border border-gray-300 rounded-md p-3 mb-4 focus:outline-none focus:border-black"
      >

      <label class="block mb-2 font-semibold">
        Message
      </label>

      <textarea
        name="data"
        rows="4"
        placeholder="Write your message..."
        required
        class="text-green-500  bg-gray-700 w-full border border-gray-300 rounded-md p-3 mb-4 focus:outline-none focus:border-black"
      ></textarea>

      <button
        type="submit"
        class="bg-black text-white px-6 py-3 rounded-md font-semibold hover:bg-gray-800 transition"
      >
        Add Message
      </button>

    </form>


    <h2 class="text-green-500 text-xl font-bold mb-4">
      Messages (<%= files.length %>)
    </h2>

    <% if (files.length === 0) { %>

      <p class="border border-gray-300 rounded-lg p-5 text-gray-600">
        No messages yet. Add your first message!
      </p>

    <% } else { %>

      <div class="space-y-4">

        <% files.forEach(function(val) { %>

          <div class="bg-white border border-gray-300 rounded-lg p-5">

            <h3 class="text-lg font-bold mb-2">
              <%= val.title %>
            </h3>

            <p class="text-black whitespace-pre-wrap">
              <%= val.data %>
            </p>

            <a href="/delete/<%= encodeURIComponent(val.title) %>"
           onclick="return confirm('Are you sure you want to delete this message?')"
          class="inline-block bg-black text-white px-4 py-2 rounded-md mt-4 hover:bg-gray-800"
         >
        Delete
        </a>

          </div>

        <% }) %>

      </div>

    <% } %>

    <p class="text-center text-sm text-gray-500 mt-10">
      Built with Node.js, Express and EJS @skeshav7050
    </p>

  </div>

</body>
</html>